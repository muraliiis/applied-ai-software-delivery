//*
//* ADRDSSU Cleanup and Restore — generated {{ now(fmt='%Y-%m-%dT%H:%M:%S') }}
//* Host      : {{ inventory_hostname }}
//* Old qual  : {{ cleanup_include_old }}
//* New qual  : {{ cleanup_include_new }}
//* Shrinkwrp : {{ tape2_dsn }}
//*
//CLEANUP  EXEC PGM=ADRDSSU{{ ",PARM='TYPRUN=NORUN'" if (typrun_norun | default(true) | bool) else '' }}
//SYSPRINT DD  SYSOUT=*
//TAPE1    DD  DUMMY
//SYSIN    DD  *
 DUMP OUTDDNAME(TAPE1)                              -
 DATASET(EXCLUDE(                                   -
                 {{ cleanup_exclude }}              -
                 )                                  -
         INCLUDE(                                   -
                 {{ cleanup_include_old }}          -
                 {{ cleanup_include_new }}          -
                ))                                  -
       SPHERE DELETE PURGE
