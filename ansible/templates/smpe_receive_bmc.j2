//BMCRCV   JOB  ({{ smpe_job_acct | default('') }}),'BMC SMPE ORDR',
//             CLASS={{ smpe_job_class | default('S') }},
//             MSGCLASS={{ smpe_job_msgclass | default('X') }},
//             NOTIFY=&SYSUID,MSGLEVEL=(1,1)
//*
//* JOB  : ACSNS.BMC.SAMPLE.JCLS(BMCORDER)
//* DESC : SMP/E RECEIVE ORDER - BMC internet delivery via GIMSMP/HTTPS
//* DATE : {{ now(fmt='%Y-%m-%dT%H:%M:%S') }}
//* HOST : {{ inventory_hostname }}
//* CSI  : {{ smpe_csi_dsn }}
//* NTS  : {{ smpe_nts_path }}  (staging directory, not a credentials file)
//* ZONE : {{ smpe_global_zone }}
//*
//SMPER1  EXEC PGM=GIMSMP,REGION=0M,
//             PARM='PROCESS=WAIT',DYNAMNBR=120
//SMPCSI   DD  DISP=SHR,DSN={{ smpe_csi_dsn }}
//SMPNTS   DD  PATHDISP=KEEP,
//             PATH='{{ smpe_nts_path }}'
//SMPOUT   DD  SYSOUT=*
//SMPRPT   DD  SYSOUT=*
//SMPLIST  DD  SYSOUT=*
//SMPLOG   DD  SYSOUT=*
//SYSPRINT DD  SYSOUT=*
//SMPJHOME DD  PATHDISP=KEEP,
//             PATH='{{ smpe_javahome_bmc | default(smpe_javahome) }}'
//SYSUT1   DD  UNIT=SYSALLDA,SPACE=(CYL,(100,200))
//SYSUT2   DD  UNIT=SYSALLDA,SPACE=(CYL,(100,200))
//SYSUT3   DD  UNIT=SYSALLDA,SPACE=(CYL,(100,200))
//SYSUT4   DD  UNIT=SYSALLDA,SPACE=(CYL,(100,200))
//SMPCNTL  DD  *
  SET BDY({{ smpe_global_zone }}).
  RECEIVE ORDER(ORDERSERVER(ORDSRVR)
{% if smpe_bmc_target_zones is defined and smpe_bmc_target_zones | length > 0 %}
          FORTGTZONES({{ smpe_bmc_target_zones }})
{% endif %}
          CLIENT(MYCLIENT)
          CONTENT(ALL)
          WAIT(30))
          .
/*
//ORDSRVR  DD  *
  <ORDERSERVER
  inventory="all"
  url="{{ smpe_bmc_orderserver_url | default('https://ws-prod.bmc.com/smpe') }}"
  keyring="{{ smpe_bmc_keyring | default('FTPACS/BMCSMPE_KEYRING') }}"
  certificate="{{ smpe_bmc_certificate | default('BMC SMPE Client Certificate') }}">
  </ORDERSERVER>
