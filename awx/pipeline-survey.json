{
  "name": "ISV Maintenance Pipeline Survey",
  "description": "Input variables for the ISV end-to-end maintenance pipeline",
  "spec": [
    {
      "question_name": "Existing Shrinkwrap DSN",
      "question_description": "Full DSN of the last shrinkwrap backup for the product being refreshed. Example: ACSNS.TDMF.V5R11M0.ZOSMFA.ZS31D.SHRNKWRP",
      "required": true,
      "type": "text",
      "variable": "shrinkwrap_dsn",
      "min": 10,
      "max": 128,
      "default": "",
      "choices": "",
      "new_question": true
    },
    {
      "question_name": "New Package Qualifier",
      "question_description": "New high-level qualifier for the refreshed package. Use ACS%S. prefix with percent wildcard. Example: ACS%S.TDMF.V5R11M0.ZOSMFB",
      "required": true,
      "type": "text",
      "variable": "new_qual",
      "min": 10,
      "max": 128,
      "default": "",
      "choices": "",
      "new_question": true
    },
    {
      "question_name": "Vendor",
      "question_description": "ISV vendor for SMP/E internet maintenance delivery.",
      "required": true,
      "type": "multiplechoice",
      "variable": "vendor",
      "min": 1,
      "max": 16,
      "default": "ibm",
      "choices": "ibm\nbroadcom\nbmc",
      "new_question": true
    },
    {
      "question_name": "Global CSI Dataset Name",
      "question_description": "SMP/E Global CSI dataset name for the new package qualifier. Example: ACSVS.TDMF.V5R11M0.ZOSMFB.GLOBAL.CSI",
      "required": true,
      "type": "text",
      "variable": "global_csi",
      "min": 10,
      "max": 128,
      "default": "",
      "choices": "",
      "new_question": true
    },
    {
      "question_name": "Target CSI Dataset Name",
      "question_description": "SMP/E Target CSI dataset name. Leave blank to use the Global CSI for all zones. Example: ACSVS.TDMF.V5R11M0.ZOSMFB.TARGET.CSI",
      "required": false,
      "type": "text",
      "variable": "target_csi",
      "min": 0,
      "max": 128,
      "default": "",
      "choices": "",
      "new_question": true
    },
    {
      "question_name": "Distribution CSI Dataset Name",
      "question_description": "SMP/E Distribution CSI dataset name. Leave blank to use the Global CSI for all zones. Example: ACSVS.TDMF.V5R11M0.ZOSMFB.DLIB.CSI",
      "required": false,
      "type": "text",
      "variable": "dlib_csi",
      "min": 0,
      "max": 128,
      "default": "",
      "choices": "",
      "new_question": true
    },
    {
      "question_name": "TARGET Zone Name",
      "question_description": "SMP/E TARGET zone name. Example: TZONE",
      "required": true,
      "type": "text",
      "variable": "target_zone",
      "min": 1,
      "max": 8,
      "default": "TZONE",
      "choices": "",
      "new_question": true
    },
    {
      "question_name": "DISTRIBUTION Zone Name",
      "question_description": "SMP/E DISTRIBUTION zone name. Example: DZONE",
      "required": true,
      "type": "text",
      "variable": "dlib_zone",
      "min": 1,
      "max": 8,
      "default": "DZONE",
      "choices": "",
      "new_question": true
    },
    {
      "question_name": "Existing Qualifier REST (qualifiers 2-N)",
      "question_description": "Qualifiers 2 through N of the existing (old) package — everything after the first qualifier. Example: TDMF.V5R11M0.ZOSMFA",
      "required": true,
      "type": "text",
      "variable": "existing_qual_rest",
      "min": 5,
      "max": 100,
      "default": "",
      "choices": "",
      "new_question": true
    },
    {
      "question_name": "New Qualifier REST (qualifiers 2-N)",
      "question_description": "Qualifiers 2 through N of the new package — everything after the first qualifier. Example: TDMF.V5R11M0.ZOSMFB",
      "required": true,
      "type": "text",
      "variable": "new_qual_rest",
      "min": 5,
      "max": 100,
      "default": "",
      "choices": "",
      "new_question": true
    },
    {
      "question_name": "Shrinkwrap Node (USERID_NODE)",
      "question_description": "Node identifying the target z/OS compatibility level. Placed between the qualifier suffix and .SHRNKWRP. Check SYSSA69.DASD.JCLLIB(SHRNKWRP) for the site convention. Example: ZS31D (z/OS 3.1), ZS32D (z/OS 3.2)",
      "required": true,
      "type": "text",
      "variable": "userid_node",
      "min": 3,
      "max": 8,
      "default": "ZS31D",
      "choices": "",
      "new_question": true
    },
    {
      "question_name": "COPYRENA Dry Run",
      "question_description": "Run COPYRENA (ADRDSSU cleanup + restore) with TYPRUN=NORUN first to validate the dataset list before committing to a live run.",
      "required": true,
      "type": "multiplechoice",
      "variable": "typrun_norun",
      "min": 4,
      "max": 5,
      "default": "true",
      "choices": "true\nfalse",
      "new_question": true
    },
    {
      "question_name": "Shrinkwrap Space Primary (CYL)",
      "question_description": "Primary space allocation in cylinders for the ADRDSSU DUMP output dataset. Increase if the new package is large. Default: 200",
      "required": false,
      "type": "integer",
      "variable": "shrnkwrp_space_primary",
      "min": 10,
      "max": 9999,
      "default": "200",
      "choices": "",
      "new_question": true
    },
    {
      "question_name": "Shrinkwrap Space Secondary (CYL)",
      "question_description": "Secondary space allocation in cylinders for the ADRDSSU DUMP output dataset. Default: 50",
      "required": false,
      "type": "integer",
      "variable": "shrnkwrp_space_secondary",
      "min": 5,
      "max": 999,
      "default": "50",
      "choices": "",
      "new_question": true
    }
  ]
}
